# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a git.

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Cantidad de proxies delante del servidor (en Render, Railway, Fly, Heroku: 1). En local déjalo vacío.
TRUST_PROXY=

# --- Base de datos PostgreSQL ---
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestorrh
DB_USER=postgres
DB_PASSWORD=
# En bases administradas en la nube normalmente se necesita: true
DB_SSL=false
# Con DB_SSL=true se comprueba el certificado de la base. Solo si el proveedor usa una autoridad propia
# (por ejemplo AWS RDS), indica aquí la ruta de su certificado .pem. Neon no lo necesita.
DB_SSL_CA=

# --- Dirección de la aplicación ---
# Origen exacto con que se abre la app (protocolo + dominio + puerto, sin ruta). Se usa para rechazar
# peticiones que vienen de otros sitios (CSRF). En local puede quedar vacío (se usa http://localhost:PORT).
# En la nube es obligatoria y con https, por ejemplo: https://gestorrh.onrender.com
APP_ORIGEN=

# --- Verificación en dos pasos (2FA) ---
# Clave de 32 bytes para cifrar los secretos del 2FA en la base. Generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Usa una distinta en cada ambiente y guárdala como la contraseña de la base: si se pierde o se cambia,
# hay que restablecer el acceso de todos los usuarios que tienen 2FA.
TOTP_CLAVE_CIFRADO=
