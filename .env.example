# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a git.

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Cantidad de proxies delante del servidor (en Render, Railway, Fly, Heroku: 1). En local déjalo vacío.
TRUST_PROXY=

# --- Base de datos PostgreSQL ---
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestorrh
DB_USER=postgres
DB_PASSWORD=
# En bases administradas en la nube normalmente se necesita: true
DB_SSL=false
# Con DB_SSL=true se comprueba el certificado de la base. Solo si el proveedor usa una autoridad propia
# (por ejemplo AWS RDS), indica aquí la ruta de su certificado .pem. Neon no lo necesita.
DB_SSL_CA=

# --- Sesiones ---
# Mínimo 32 caracteres aleatorios. Generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión (30m, 8h, 1d)
JWT_EXPIRES_IN=8h
